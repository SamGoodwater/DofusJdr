{
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "prebuild": "pnpm run sass:build && node scripts/inject-theme-vars.cjs",
        "build": "vite build",
        "preview": "vite preview",
        "dev": "vite",
        "dev:optimized": "vite --mode development --force",
        "dev:css": "concurrently \"pnpm run css\" \"pnpm run dev\"",
        "dev:css:optimized": "concurrently \"pnpm run css\" \"pnpm run dev:optimized\"",
        "dev:css:optimized:watch": "concurrently --kill-others \"pnpm run css:watch\" \"pnpm run dev:optimized\"",
        "sass:watch": "sass --watch --no-source-map resources/scss/custom.scss:resources/css/custom.css resources/scss/theme.scss:resources/css/theme.css",
        "sass:build": "sass --no-source-map resources/scss/custom.scss:resources/css/custom.css resources/scss/theme.scss:resources/css/theme.css --style expanded",
        "scss": "sass --watch --no-source-map resources/scss:resources/css",
        "css": "node scripts/build-css.cjs --clean --minify --inject",
        "css:clean": "node scripts/clean-css.cjs --verbose",
        "css:watch": "node scripts/build-css.cjs --clean --minify --inject --watch",
        "css:watch:verbose": "node scripts/build-css.cjs --clean --minify --inject --watch --verbose",
        "css:verbose": "node scripts/build-css.cjs --clean --minify --inject --verbose",
        "update:atomic-index": "node docs/scripts/generate_atomic_index.cjs",
        "update:docs": "node docs/scripts/generate_index_schema_docs.cjs && pnpm run update:atomic-index",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:a11y": "vitest run tests/a11y/",
        "playwright:install": "playwright install chromium",
        "test:e2e": "playwright test tests/e2e/",
        "audit:docs": "node docs/scripts/audit-docs-quality.cjs",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint resources/js/Pages/Organismes/section resources/js/Pages/Pages/page resources/js/Utils/security resources/js/Composables/pages resources/js/Pages/Molecules/header/LoggedHeaderContainer.vue resources/js/Pages/Organismes/table/TanStackTable.vue resources/js/Pages/Atoms/data-input/DateCore.vue",
        "project:review:cursor-agents": "node scripts/cursor-dev-review-agents.mjs",
        "secrets:scan": "node scripts/scan-secrets.mjs",
        "secrets:scan:pre-push": "node scripts/scan-secrets.mjs --mode=pre-push"
    },
    "devDependencies": {
        "@cursor/sdk": "^1.0.38",
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^3.9.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/oxide": "4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vitest/ui": "^4.1.12",
        "@vue/server-renderer": "^3.5.44",
        "@vue/test-utils": "^2.5.1",
        "autoprefixer": "^10.6.1",
        "axios": "^1.20.0",
        "concurrently": "^10.0.6",
        "csso": "^5.0.5",
        "daisyui": "^5.7.50",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^16.5.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^1.3.0",
        "postcss": "^8.5.31",
        "sass": "^1.105.2",
        "tailwindcss": "^4.3.3",
        "vite": "^6.4.4",
        "vitest": "^4.1.12",
        "vitest-axe": "^0.1.0",
        "vue": "^3.5.44",
        "vue-eslint-parser": "^10.4.1"
    },
    "dependencies": {
        "@csstools/postcss-oklab-function": "^5.0.15",
        "@floating-ui/dom": "^1.8.0",
        "@floating-ui/vue": "^2.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/table-core": "^9.3.1",
        "@tanstack/vue-table": "^9.3.1",
        "@tanstack/vue-virtual": "^3.13.47",
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-color": "^3.32.0",
        "@tiptap/extension-highlight": "^3.32.0",
        "@tiptap/extension-image": "^3.32.0",
        "@tiptap/extension-list": "^3.32.0",
        "@tiptap/extension-subscript": "^3.32.0",
        "@tiptap/extension-superscript": "^3.32.0",
        "@tiptap/extension-table": "^3.32.0",
        "@tiptap/extension-text-align": "^3.32.0",
        "@tiptap/extension-text-style": "^3.32.0",
        "@tiptap/extensions": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "@tiptap/vue-3": "^3.32.0",
        "@vue/devtools-api": "^8.2.1",
        "cally": "^0.9.2",
        "chart.js": "^4.5.1",
        "colord": "^2.10.0",
        "comment-parser": "^1.4.9",
        "dompurify": "^3.4.17",
        "dotenv": "^17.4.2",
        "glob": "^13.0.6",
        "interactjs": "^1.10.28",
        "marked": "^18.1.1",
        "mysql2": "^3.24.6",
        "photoswipe": "^5.4.4",
        "pinia": "^4.1.0",
        "playwright": "^1.64.1"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-darwin-arm64": "4.3.3",
        "@tailwindcss/oxide-darwin-x64": "4.3.3",
        "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
        "@tailwindcss/oxide-win32-arm64-msvc": "4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "4.3.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "@tailwindcss/oxide",
            "esbuild",
            "vue-demi"
        ],
        "ignoredBuiltDependencies": [
            "@anthropic-ai/claude-code"
        ],
        "overrides": {
            "qs": "6.16.0",
            "brace-expansion@1": "1.1.18",
            "brace-expansion@2": "2.1.4",
            "brace-expansion@5": "5.0.12",
            "@tailwindcss/typography>postcss-selector-parser": "7.1.6"
        }
    }
}
